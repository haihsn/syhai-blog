---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  book: CollectionEntry<'books'>;
  hasTakeaways: boolean;
}

const { book, hasTakeaways } = Astro.props;
const { title, author, cover, category, status, progress } = book.data;
---

<button
  class="book-card"
  type="button"
  data-cat={category}
  data-favorite={book.data.favorite ? 'true' : 'false'}
  data-book={book.slug}
  data-title={title}
  data-author={author}
  disabled={!hasTakeaways}
>
  <span class="hub-book-cover">
    {cover ? <img src={cover} alt={title} /> : <span>{title}</span>}
  </span>
  <span class="hub-book-title">{title}</span>
  <span class="hub-book-author">{author}</span>
  {status === 'reading' && progress != null && (
    <span class="hub-progress"><span class="hub-progress__fill" style={`width:${progress}%`}></span></span>
  )}
</button>

<style>
.book-card {
  display: block;
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  padding: 0;
  font: inherit;
  color: inherit;
  cursor: pointer;
}
.book-card[disabled] { cursor: default; }
.book-card.hidden { display: none; }
.book-card :global(.hub-book-cover) { transition: transform 0.15s, box-shadow 0.15s; }
.book-card:not([disabled]):hover :global(.hub-book-cover) {
  transform: translateY(-3px);
  box-shadow: 0 6px 20px rgba(0,0,0,0.10);
}
.book-card:not([disabled]):focus-visible :global(.hub-book-cover) {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}
</style>
