---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  book: CollectionEntry<'books'>;
  hasTakeaways: boolean;
}

const { book, hasTakeaways } = Astro.props;
const { title, author, cover, category, status, progress } = book.data;
---

<button
  class="book-card"
  type="button"
  data-cat={category}
  data-favorite={book.data.favorite ? 'true' : 'false'}
  data-book={book.slug}
  data-title={title}
  data-author={author}
  disabled={!hasTakeaways}
>
  <span class="hub-book-cover">
    {cover ? <img src={cover} alt={title} /> : <span>{title}</span>}
  </span>
  <span class="hub-book-title">{title}</span>
  <span class="hub-book-author">{author}</span>
  {status === 'reading' && progress != null && (
    <span class="hub-progress"><span class="hub-progress__fill" style={`width:${progress}%`}></span></span>
  )}
</button>

<style>
.book-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  padding: 0;
  font: inherit;
  color: inherit;
  cursor: pointer;
}
.book-card[disabled] { cursor: default; }
.book-card.hidden { display: none; }
.book-card :global(.hub-book-cover),
.book-card :global(.hub-book-title) {
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease, color 0.22s ease;
}
/* Accent glow — same colour as the nav link hover on the homepage. */
.book-card:not([disabled]):hover :global(.hub-book-cover) {
  transform: translateY(-6px) scale(1.02);
  border-color: rgba(var(--accent-rgb), 0.9);
  box-shadow:
    0 0 0 2px rgba(var(--accent-rgb), 0.55),
    0 0 26px 4px rgba(var(--accent-rgb), 0.45),
    0 12px 28px rgba(0, 0, 0, 0.16);
}
.book-card:not([disabled]):hover :global(.hub-book-title) { color: var(--accent); }

/* Respect users who ask for reduced motion — keep the glow, drop the movement. */
@media (prefers-reduced-motion: reduce) {
  .book-card:not([disabled]):hover :global(.hub-book-cover) { transform: none; }
}
.book-card:not([disabled]):focus-visible :global(.hub-book-cover) {
  outline: 2px solid var(--accent);
  outline-offset: 3px;
}
</style>
