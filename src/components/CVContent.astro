---
import { cvData } from '../config/cv';
---

<header class="cv-header">
  <h1 class="cv-name">{cvData.name}</h1>
  <p class="cv-title">{cvData.title}</p>
</header>

<section class="cv-section">
  <h2 class="cv-section__label">Experience</h2>
  <div class="cv-timeline">
    {cvData.experience.map(job => (
      <div class="cv-entry">
        <div class="cv-entry__head">
          <div>
            <h3 class="cv-entry__role">{job.role}</h3>
            <p class="cv-entry__company">{job.company}</p>
          </div>
          <span class="cv-entry__dates">{job.dates}</span>
        </div>
        <ul class="cv-entry__bullets">
          {job.bullets.map(b => <li>{b}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>

<section class="cv-section">
  <h2 class="cv-section__label">Skills</h2>
  <div class="cv-skills">
    {cvData.skills.map(s => <span class="tag tag--outline">{s}</span>)}
  </div>
</section>

<style>
/* ── CV header ── */
.cv-header { margin-top: 0.75rem; margin-bottom: 2.5rem; }
.cv-name {
  font-family: var(--playfair);
  font-style: italic;
  font-weight: 400;
  font-size: clamp(2.25rem, 5vw, 3rem);
  color: var(--ink);
  letter-spacing: -0.01em;
}
.cv-title {
  font-family: var(--serif);
  font-size: 1.1rem;
  color: var(--ink2);
  margin-top: 0.4rem;
}

/* ── Sections ── */
.cv-section { margin-top: 2.5rem; }
.cv-section__label {
  font-family: var(--mono);
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--ink2);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 1.25rem;
  padding-bottom: 0.75rem;
  border-bottom: 1px solid var(--rule);
}

/* ── Timeline ── */
.cv-timeline { display: flex; flex-direction: column; gap: 2rem; }
.cv-entry__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 1rem;
  flex-wrap: wrap;
}
.cv-entry__role {
  font-family: var(--source);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--ink);
}
.cv-entry__company {
  font-family: var(--serif);
  font-size: 0.98rem;
  color: var(--ink2);
  margin-top: 2px;
}
.cv-entry__dates {
  font-family: var(--mono);
  font-size: 0.78rem;
  color: var(--b400);
  white-space: nowrap;
}
.cv-entry__bullets {
  margin-top: 0.9rem;
  padding-left: 1.25rem;
}
.cv-entry__bullets li {
  font-family: var(--serif);
  font-size: 1rem;
  line-height: 1.6;
  color: var(--ink);
  margin-bottom: 0.4rem;
}

/* ── Skills ── */
.cv-skills { display: flex; flex-wrap: wrap; gap: 0.5rem 0.75rem; }
.cv-skills .tag {
  padding: 5px 12px;
  border: 1px solid var(--rule);
  border-radius: var(--radius);
}
</style>
