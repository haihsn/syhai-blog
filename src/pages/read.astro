---
import Base from '../layouts/Base.astro';
import BookCard from '../components/BookCard.astro';
import { getCollection } from 'astro:content';

const books = (await getCollection('books'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

// A book's markdown body is its key-takeaways note. Books with an empty body
// render as non-clickable cards.
const entries = await Promise.all(
  books.map(async book => ({
    book,
    hasTakeaways: book.body.trim().length > 0,
    Content: (await book.render()).Content,
  }))
);

const categories = [...new Set(books.map(b => b.data.category))].sort();

const byStatus = (status: string) => entries.filter(e => e.book.data.status === status);
const shelves = [
  { label: 'Currently Reading', items: byStatus('reading') },
  { label: 'Up Next',           items: byStatus('up-next') },
  { label: 'Finished',          items: byStatus('read') },
].filter(s => s.items.length > 0);
---

<Base title="Read — syhai.xyz" description="Books, research and reports I'm reading, about to read, and have read.">

  <div class="hub-page container--wide">

    <a href="/" class="hub-back">← Back</a>
    <h1 class="hub-title">Read</h1>

    <div class="hub-toolbar">
      <div class="hub-pill-row">
        <button class="hub-pill active" data-filter="all">All</button>
        <button class="hub-pill" data-filter="favorites">★ Favorites</button>
        {categories.map(cat => (
          <button class="hub-pill" data-filter={cat}>{cat}</button>
        ))}
      </div>
      <span class="hub-count"><strong>{books.length}</strong> items</span>
    </div>

    {shelves.map(shelf => (
      <section class="hub-shelf" data-shelf>
        <h2 class="hub-section-label">{shelf.label}</h2>
        <div class="hub-book-grid">
          {shelf.items.map(({ book, hasTakeaways }) => (
            <BookCard book={book} hasTakeaways={hasTakeaways} />
          ))}
        </div>
      </section>
    ))}

  </div>

  <!-- Rendered takeaway notes, cloned into the modal on click -->
  <div class="book-takeaways" hidden>
    {entries.filter(e => e.hasTakeaways).map(({ book, Content }) => (
      <div data-takeaway={book.slug}><Content /></div>
    ))}
  </div>

  <div id="book-modal" class="book-modal" hidden>
    <div class="book-modal__backdrop" data-close></div>
    <div class="book-modal__panel" role="dialog" aria-modal="true" aria-labelledby="book-modal-title">
      <button class="book-modal__close" data-close aria-label="Close">&times;</button>
      <h2 id="book-modal-title" class="book-modal__title"></h2>
      <p id="book-modal-author" class="book-modal__author"></p>
      <div id="book-modal-body" class="book-modal__body"></div>
    </div>
  </div>

</Base>

<style>
.hub-page { padding: 3rem 0 5rem; }
.hub-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
  margin-bottom: 2.5rem;
}
.hub-shelf { margin-bottom: 2.75rem; }
.hub-shelf.hidden { display: none; }
.hub-shelf .hub-section-label { display: block; margin-bottom: 1rem; }
.hub-book-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 1.5rem;
}
@media (max-width: 600px) {
  .hub-book-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 1rem; }
}
</style>

<script>
  // ── Filters ──
  const pills   = document.querySelectorAll<HTMLButtonElement>('.hub-pill');
  const cards   = document.querySelectorAll<HTMLElement>('.book-card');
  const shelves = document.querySelectorAll<HTMLElement>('[data-shelf]');

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      const filter = pill.dataset.filter ?? 'all';

      cards.forEach(card => {
        const matches =
          filter === 'all'       ? true :
          filter === 'favorites' ? card.dataset.favorite === 'true' :
                                   card.dataset.cat === filter;
        card.classList.toggle('hidden', !matches);
      });

      shelves.forEach(shelf => {
        const visible = shelf.querySelectorAll('.book-card:not(.hidden)').length > 0;
        shelf.classList.toggle('hidden', !visible);
      });
    });
  });

  // ── Takeaways modal ──
  const modal      = document.getElementById('book-modal');
  const modalTitle = document.getElementById('book-modal-title');
  const modalBy    = document.getElementById('book-modal-author');
  const modalBody  = document.getElementById('book-modal-body');
  let lastFocused: HTMLElement | null = null;

  function openModal(card: HTMLElement) {
    const slug = card.dataset.book;
    const source = document.querySelector(`[data-takeaway="${slug}"]`);
    if (!modal || !modalTitle || !modalBy || !modalBody || !source) return;

    lastFocused = card;
    modalTitle.textContent = card.dataset.title ?? '';
    modalBy.textContent    = card.dataset.author ?? '';
    modalBody.innerHTML    = source.innerHTML;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    modal.querySelector<HTMLButtonElement>('.book-modal__close')?.focus();
  }

  function closeModal() {
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = '';
    lastFocused?.focus();
    lastFocused = null;
  }

  cards.forEach(card => {
    card.addEventListener('click', () => {
      if (!(card as HTMLButtonElement).disabled) openModal(card);
    });
  });

  modal?.querySelectorAll('[data-close]').forEach(el =>
    el.addEventListener('click', closeModal)
  );

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
  });
</script>
