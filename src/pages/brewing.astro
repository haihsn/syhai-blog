---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const groups = [
  { label: 'Apps',  items: projects.filter(p => p.data.kind === 'apps') },
  { label: 'Doors', items: projects.filter(p => p.data.kind === 'doors') },
];
---

<Base title="Brewing — syhai.xyz" description="What I'm building — software and businesses.">

  <div class="hub-page container--wide">

    <a href="/" class="hub-back">← Back</a>
    <h1 class="hub-title">Brewing</h1>

    {groups.map(group => (
      <section class="hub-shelf">
        <h2 class="hub-section-label">{group.label}</h2>

        {group.items.length === 0 ? (
          <p class="hub-empty">Nothing here yet.</p>
        ) : (
          <div class="brew-grid">
            {group.items.map(p => {
              const external = p.data.url?.startsWith('http');
              const Tag = p.data.url ? 'a' : 'div';
              return (
                <Tag
                  class="hub-card brew-card"
                  href={p.data.url}
                  target={external ? '_blank' : undefined}
                  rel={external ? 'noopener' : undefined}
                >
                  {(p.data.logo || p.data.status) && (
                    <span class="brew-card__head">
                      {p.data.logo && (
                        <span class="hub-logo"><img src={p.data.logo} alt="" /></span>
                      )}
                      {p.data.status && <span class="hub-list-row__status">{p.data.status}</span>}
                    </span>
                  )}
                  <span class="brew-card__title">{p.data.title}</span>
                  {p.data.description && (
                    <span class="brew-card__desc">{p.data.description}</span>
                  )}
                </Tag>
              );
            })}
          </div>
        )}
      </section>
    ))}

  </div>

</Base>

<style>
.hub-page { padding-top: 3rem; padding-bottom: 5rem; }
.hub-shelf { margin-bottom: 2.75rem; }
.hub-shelf .hub-section-label { display: block; margin-bottom: 1rem; }

.hub-empty {
  font-family: var(--serif);
  font-size: 1.05rem;
  color: var(--ink2);
}

.brew-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
  gap: 1rem;
}
.brew-card { display: block; }
/* Same accent glow as the book covers on /read. Links only, since a card
   without a url is not interactive. */
a.brew-card {
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
}
a.brew-card:hover {
  transform: translateY(-4px);
  border-color: rgba(var(--accent-rgb), 0.9);
  box-shadow:
    0 0 0 2px rgba(var(--accent-rgb), 0.55),
    0 0 26px 4px rgba(var(--accent-rgb), 0.45),
    0 12px 28px rgba(0, 0, 0, 0.16);
}
a.brew-card:hover .brew-card__title { color: var(--accent); }
.brew-card__title { transition: color 0.22s ease; }

@media (prefers-reduced-motion: reduce) {
  a.brew-card:hover { transform: none; }
}
.brew-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  margin-bottom: 0.9rem;
}
/* Keeps the status on the right even when a card has no logo. */
.brew-card__head :global(.hub-list-row__status) { margin-left: auto; }
.brew-card__title {
  display: block;
  font-family: var(--source);
  font-weight: 600;
  font-size: 1rem;
  color: var(--ink);
}
.brew-card__desc {
  display: block;
  font-family: var(--serif);
  font-size: 1rem;
  line-height: 1.55;
  color: var(--ink2);
  margin-top: 3px;
}

@media (max-width: 600px) {
  .brew-grid { grid-template-columns: 1fr; }
}
</style>
