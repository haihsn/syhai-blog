---
import Base from '../layouts/Base.astro';

const sections = [
  { label: 'Thoughts', href: '/blog' },
  { label: 'Read',     href: '/read' },
  { label: 'Brewing',  href: '/brewing' },
  { label: 'Contact',  href: '/contact' },
];
---

<Base title="Sy Hai — syhai.xyz" bare>

  <div class="home">

    <header class="fade-up">
      <h1 class="hub-name">Sy Hai</h1>
      <p class="hub-location">HCMC, Vietnam</p>
    </header>

    <p class="hub-bio fade-up-1">
      Four games. Different edges. Same player.
      <br /><br />
      25% trader, 25% poker player, 25% hired hands, 25% solo creator.
      Everything I've made, backed, or bet on is here.
    </p>

    <nav class="hub-link-row home__sections fade-up-2">
      {sections.map(s => <a href={s.href}>{s.label}</a>)}
    </nav>

  </div>

</Base>

<style>
.home {
  max-width: 680px;
  margin: 0 auto;
  padding: clamp(4rem, 14vh, 9rem) 1.75rem 5rem;
}

.home__sections { margin-top: 3.25rem; }

@media (max-width: 600px) {
  .home__sections { gap: 0.5rem 1.5rem; }
}
</style>
