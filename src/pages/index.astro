---
import Base from '../layouts/Base.astro';

const sections = [
  { label: 'Writing',   href: '/blog' },
  { label: 'Bookshelf', href: '/bookshelf' },
  { label: 'Building',  href: '/building' },
  { label: 'Meet me',   href: '/meet' },
  { label: 'About',     href: '/about' },
];
---

<Base title="Sy Hai — syhai.xyz" bare>

  <div class="home">

    <header class="fade-up">
      <h1 class="hub-name">Sy Hai</h1>
      <p class="hub-location">HCMC, Vietnam</p>
    </header>

    <p class="hub-bio fade-up-1">
      AI &amp; crypto research. I use Claude to build trading systems, automate
      research, and analyze on-chain data — then write down everything that
      worked and everything that didn't.
    </p>

    <nav class="hub-link-row home__sections fade-up-2">
      {sections.map(s => <a href={s.href}>{s.label}</a>)}
    </nav>

  </div>

</Base>

<style>
.home {
  max-width: 680px;
  margin: 0 auto;
  padding: clamp(4rem, 14vh, 9rem) 1.75rem 5rem;
}

.home__sections { margin-top: 3.25rem; }

@media (max-width: 600px) {
  .home__sections { gap: 0.5rem 1.5rem; }
}
</style>
