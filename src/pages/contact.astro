---
import Base from '../layouts/Base.astro';
---

<Base title="Contact — syhai.xyz" description="Find me on X/Telegram @syngochai.">

  <div class="hub-page container">

    <a href="/" class="hub-back">← Back</a>
    <h1 class="hub-title">Contact</h1>

    <p class="hub-intro">
      Find me on <a href="https://x.com/syngochai" target="_blank" rel="noopener">X</a>/<a href="https://t.me/syngochai" target="_blank" rel="noopener">Telegram</a> @syngochai.
    </p>

  </div>

</Base>

<style>
.hub-page { padding-top: 3rem; padding-bottom: 5rem; max-width: 680px; margin: 0 auto; }
.hub-intro {
  font-family: var(--source);
  font-size: 1.05rem;
  color: var(--ink2);
  line-height: 1.7;
  margin-bottom: 2rem;
}
.hub-intro a { color: var(--accent); }
</style>
