---
import Base from '../layouts/Base.astro';

// Add a `video` path (e.g. "/videos/football-highlights.mp4") once a
// highlight-moments clip exists for that activity — the card unlocks
// and becomes clickable automatically.
const activities = [
  { name: 'Pickleball',         video: '' },
  { name: 'Muay Thai Sparring', video: '' },
  { name: 'PUBG | Valorant',    video: '' },
  { name: 'Football',           video: '' },
];
---

<Base title="Contact — syhai.xyz" description="Find me on X @syngochai. Want to play something?">

  <div class="hub-page container">

    <a href="/" class="hub-back">← Back</a>
    <h1 class="hub-title">Contact</h1>

    <p class="hub-intro">
      Find me on <a href="https://x.com/syngochai" target="_blank" rel="noopener">X @syngochai</a>.
      Want to play something?
    </p>

    <div class="activity-grid">
      {activities.map(a => (
        <button
          class="activity-card"
          type="button"
          data-video={a.video}
          disabled={!a.video}
        >
          <span class="activity-card__icon">▶</span>
          <span class="activity-card__name">{a.name}</span>
        </button>
      ))}
    </div>

  </div>

  <div id="activity-modal" class="book-modal" hidden>
    <div class="book-modal__backdrop" data-close></div>
    <div class="book-modal__panel" role="dialog" aria-modal="true" aria-labelledby="activity-modal-title">
      <button class="book-modal__close" data-close aria-label="Close">&times;</button>
      <h2 id="activity-modal-title" class="book-modal__title"></h2>
      <div id="activity-modal-video" class="activity-modal__video"></div>
    </div>
  </div>

</Base>

<style>
.hub-page { padding: 3rem 0 5rem; max-width: 680px; margin: 0 auto; }
.hub-intro {
  font-family: var(--source);
  font-size: 1.05rem;
  color: var(--ink2);
  line-height: 1.7;
  margin-bottom: 2rem;
}
.hub-intro a { color: var(--accent); }

.activity-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 1rem;
  margin-top: 1rem;
}
.activity-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.6rem;
  aspect-ratio: 1;
  padding: 1rem;
  border: 1px solid var(--rule);
  border-radius: var(--radius);
  background: var(--b100);
  cursor: pointer;
  transition: border-color 0.15s, transform 0.15s;
}
.activity-card:not([disabled]):hover { border-color: var(--accent); transform: translateY(-2px); }
.activity-card[disabled] { cursor: default; opacity: 0.55; }
.activity-card__icon {
  font-size: 1.1rem;
  color: var(--ink2);
}
.activity-card:not([disabled]) .activity-card__icon { color: var(--accent); }
.activity-card__name {
  font-family: var(--source);
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
  line-height: 1.3;
}

.activity-modal__video { margin-top: 1.5rem; }
.activity-modal__video video { display: block; width: 100%; border-radius: calc(var(--radius) - 4px); }
</style>

<script>
  const modal      = document.getElementById('activity-modal');
  const modalTitle = document.getElementById('activity-modal-title');
  const modalVideo = document.getElementById('activity-modal-video');
  let lastFocused: HTMLElement | null = null;

  function openModal(card: HTMLButtonElement) {
    const src = card.dataset.video;
    if (!modal || !modalTitle || !modalVideo || !src) return;

    lastFocused = card;
    modalTitle.textContent = card.querySelector('.activity-card__name')?.textContent ?? '';
    modalVideo.innerHTML = `<video src="${src}" controls autoplay playsinline></video>`;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    modal.querySelector<HTMLButtonElement>('.book-modal__close')?.focus();
  }

  function closeModal() {
    if (!modal || !modalVideo) return;
    modal.hidden = true;
    modalVideo.innerHTML = '';
    document.body.style.overflow = '';
    lastFocused?.focus();
    lastFocused = null;
  }

  document.querySelectorAll<HTMLButtonElement>('.activity-card').forEach(card => {
    card.addEventListener('click', () => {
      if (!card.disabled) openModal(card);
    });
  });

  modal?.querySelectorAll('[data-close]').forEach(el =>
    el.addEventListener('click', closeModal)
  );

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && modal && !modal.hidden) closeModal();
  });
</script>
