---
import Base from './Base.astro';
import type { CollectionEntry } from 'astro:content';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, category, readTime, cover } = post.data;

function fmt(date: Date) {
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const shareURL  = `https://syhai.xyz/blog/${post.slug}`;
const tweetURL  = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(shareURL)}`;
---

<Base title={`${title} — syhai.xyz`} description={description} ogImage={cover}>

  <article class="post">

    <!-- POST HEADER — category kicker + headline + centered byline -->
    <div class="post__header">
      <div class="container">

        <!-- Kicker: back link + category -->
        <div class="post__kicker fade-up">
          <a href="/blog" class="post__back">← All posts</a>
          <span class="post__kicker-sep">|</span>
          <span class="tag">{category}</span>
        </div>

        <!-- Headline -->
        <h1 class="post__title fade-up-1">{title}</h1>

        <!-- Byline -->
        <div class="post__byline fade-up-2">
          <span class="post__byline-by">By <a href="https://x.com/syngochai" target="_blank" rel="noopener">Sy Hai</a></span>
          <span class="post__byline-date">Published {fmt(pubDate)} · {readTime} min read</span>
        </div>

      </div>
    </div>

    <!-- BODY -->
    <div class="post__body container">
      <div class="prose">
        <slot />
      </div>
    </div>

    <!-- POST FOOTER -->
    <footer class="post__footer">
      <div class="container">
        <div class="cta-strip">
          <span class="section-label">▸ Enjoyed this post?</span>
          <div class="cta-strip__actions">
            <a href="/blog" class="btn">← Back to all posts</a>
            <a href={tweetURL} target="_blank" rel="noopener" class="btn btn--solid">Share on X →</a>
          </div>
        </div>
      </div>
    </footer>

  </article>

</Base>

<style>
/* ── POST HEADER ── */
.post__header {
  padding: 2.5rem 0 2rem;
  border-bottom: 0.5px solid var(--rule);
}

.post__kicker {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 1.5rem;
  flex-wrap: wrap;
}
.post__back {
  font-family: var(--source);
  font-size: 0.95rem;
  color: var(--ink2);
  transition: color 0.15s;
}
.post__back:hover { color: var(--accent); }
.post__kicker-sep { color: var(--b300); font-family: var(--source); font-size: 0.9rem; }

.post__title {
  font-size: clamp(1.9rem, 4.5vw, 2.9rem);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.15;
  margin-bottom: 1rem;
  color: var(--ink);
}

.post__byline {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  text-align: center;
  margin-top: 1.75rem;
  padding-top: 1.5rem;
  border-top: 0.5px solid var(--rule);
}
.post__byline-by {
  font-family: var(--mono);
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink2);
}
.post__byline-by a {
  color: var(--ink2);
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color 0.15s;
}
.post__byline-by a:hover { color: var(--accent); }
.post__byline-date {
  font-family: var(--mono);
  font-size: 0.66rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--b400);
}

/* ── BODY ── */
.post__body { padding: 3rem 0 2.5rem; }

.prose {
  max-width: 680px;
  border-left: 1px solid var(--rule);
  padding-left: 1.75rem;
}

.prose :global(h2) {
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-top: 3rem;
  margin-bottom: 0.75rem;
  padding-top: 1.75rem;
  border-top: 1px solid var(--rule);
  color: var(--ink);
}
.prose :global(h3) {
  font-size: 1.2rem;
  font-weight: 600;
  letter-spacing: -0.02em;
  margin-top: 2rem;
  margin-bottom: 0.6rem;
  color: var(--ink);
}
.prose :global(p) {
  font-size: 1.2rem;
  color: var(--ink);
  line-height: 1.75;
  margin-bottom: 1.3rem;
  font-family: var(--serif);
}
.prose :global(ul),
.prose :global(ol) { padding-left: 1.5rem; margin-bottom: 1.25rem; color: var(--ink); }
.prose :global(li) { margin-bottom: 0.4rem; line-height: 1.7; font-size: 1.15rem; font-family: var(--serif); }
.prose :global(a)  { color: var(--accent); border-bottom: 1px solid var(--rule); transition: color 0.15s, border-color 0.15s; }
.prose :global(a:hover) { color: var(--accent); border-bottom-color: var(--accent); }
.prose :global(strong)  { color: var(--ink); font-weight: 700; }
.prose :global(img)     { margin: 2rem 0; width: 100%; }
.prose :global(iframe)  { margin: 2rem 0; }

/* ── POST FOOTER ── */
.post__footer {
  border-top: 0.5px solid var(--rule);
  padding: 1.5rem 0;
  background: var(--b100);
}

@media (max-width: 600px) {
  .post__header { padding: 1.75rem 0 1.5rem; }
  .post__title  { font-size: 1.85rem; }
  .prose        { border-left: none; padding-left: 0; }
}
</style>
