---
import '../styles/global.css';

export interface Props {
  title:       string;
  description?: string;
  ogImage?:    string;
  bare?:       boolean;
}

const {
  title,
  description = 'AI & crypto research. Building trading systems with Claude. Learning in public.',
  ogImage,
  bare = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonical} />
  <meta name="generator" content={Astro.generator} />

  <title>{title}</title>
  <meta name="description" content={description} />

  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={canonical} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}

  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:site"        content="@syngochai" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  {ogImage && <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />}

  <!-- Prevent flash of wrong theme -->
  <script is:inline>
    if (localStorage.getItem('theme') === 'dark') {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>

<body>

  <!-- ══ NAV ══ -->
  {!bare && (
    <nav class="nav">
      <div class="nav__masthead">
        <div class="nav__brand">
          <a href="/" class="nav__logo">syhai.xyz</a>
          <p class="nav__tagline">Learning in public</p>
        </div>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
          <span class="icon-light">☾</span>
          <span class="icon-dark">☀</span>
        </button>
      </div>
    </nav>
  )}

  <main>
    <slot />
  </main>

  <!-- ══ FOOTER ══ -->
  {!bare && (
    <footer class="footer">
      <div class="footer__inner container--wide">
        <span class="footer__name">syhai.xyz</span>
        <div class="footer__links">
          <a href="/blog">Writing</a>
          <a href="/bookshelf">Bookshelf</a>
          <a href="/building">Building</a>
          <a href="/meet">Meet me</a>
          <a href="/about">About</a>
          <a href="https://x.com/syngochai" target="_blank" rel="noopener">X</a>
          <a href="/rss.xml">RSS</a>
        </div>
        <span class="footer__copy">© {new Date().getFullYear()} Sy Hai</span>
      </div>
    </footer>
  )}

  <script>
    const toggle = document.getElementById('theme-toggle');
    toggle?.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme',
        document.documentElement.classList.contains('dark') ? 'dark' : 'light'
      );
    });
  </script>

</body>
</html>

<style>
/* ── NAV ── */
.nav {
  background: var(--bg);
  border-bottom: 0.5px solid var(--rule);
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav__masthead {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 1.75rem 12px;
  max-width: 1100px;
  margin: 0 auto;
}

.nav__brand {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.nav__logo {
  font-family: var(--source);
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.03em;
  line-height: 1;
  display: block;
}
.nav__logo:hover { color: var(--accent); }

.nav__tagline {
  font-family: var(--serif);
  font-style: italic;
  font-size: 0.9rem;
  color: var(--ink2);
}

/* Theme toggle */
.theme-toggle {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 1rem;
  color: var(--ink2);
  padding: 4px 6px;
  line-height: 1;
  transition: color 0.15s;
  flex-shrink: 0;
}
.theme-toggle:hover { color: var(--ink); }
/* Light is the default: show the moon (switch to dark). In dark, show the sun. */
.icon-light { display: inline; }
.icon-dark  { display: none; }
:global(html.dark) .icon-light { display: none; }
:global(html.dark) .icon-dark  { display: inline; }

/* ── FOOTER ── */
.footer {
  background: var(--bg);
  border-top: 0.5px solid var(--rule);
  padding: 1.5rem 0;
  margin-top: 2rem;
}
.footer__inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 1rem;
}
.footer__name {
  font-family: var(--source);
  font-size: 0.95rem;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.03em;
}
.footer__links {
  display: flex;
  flex-wrap: wrap;
  gap: 1.5rem;
}
.footer__links a {
  font-family: var(--source);
  font-size: 0.92rem;
  color: var(--ink2);
  transition: color 0.15s;
}
.footer__links a:hover { color: var(--accent); }
.footer__copy {
  font-family: var(--serif);
  font-size: 0.9rem;
  color: var(--b400);
}

@media (max-width: 600px) {
  .nav__tagline { display: none; }
  .footer__copy { display: none; }
}
</style>
